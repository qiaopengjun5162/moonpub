# Copy this file to .env and fill in your own values.
# MoonPub loads .env and ~/.moonpub.env at startup (existing env vars take precedence).

# Required for push / ship / publish to WeChat Official Account drafts.
WECHAT_APPID=wx...
WECHAT_SECRET=your_secret

# Optional: overrides [articles].root in moonpub.toml.
MOONPUB_VAULT=/path/to/your/articles

# Optional: required only for AI commands (write / expand / polish / ship --ai).
# Supported providers: deepseek, openai. Model defaults to provider's recommended model.
# Provider/model are configured in moonpub.toml [ai] section; env vars below are only for keys.
# You can also set DEEPSEEK_API_KEY or OPENAI_API_KEY directly.
DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
