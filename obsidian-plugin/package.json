{
  "name": "obsidian-moonpub",
  "version": "0.4.2",
  "description": "从 Obsidian 调用本地 MoonPub 发布副驾驶",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "npm run typecheck && node --test workflow-ui.test.mjs",
    "typecheck": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --strict workflow-ui.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "latest",
    "obsidian": "latest",
    "typescript": "^5.0.0"
  }
}
