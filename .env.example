# Copy this file to .env and fill in your own values.
# MoonPub loads .env and ~/.moonpub.env at startup (existing env vars take precedence).

# Required for push / ship / publish to WeChat Official Account drafts.
WECHAT_APPID=wx...
WECHAT_SECRET=your_secret

# Optional: overrides [articles].root in moonpub.toml.
MOONPUB_VAULT=/path/to/your/articles

# Optional: required only for AI commands (write / expand / polish / ship --ai).
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
